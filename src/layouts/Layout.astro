---
import '../styles/global.css';
const { title = 'Matchups', description = 'Create and play simple matching games.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · Matchups</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Matchups home"><span aria-hidden="true">✦</span> Matchups</a>
      <nav aria-label="Main navigation">
        <a href="/">Browse</a>
        <a class="button button-small" href="/create">Create a game</a>
      </nav>
    </header>
    <main class="page-shell"><slot /></main>
    <footer class="site-footer">
      <span>Simple matching games</span>
      <a class="github-link" href="https://github.com/Pikqi/spojnice" aria-label="Matchups on GitHub">
        <svg aria-hidden="true" viewBox="0 0 24 24" role="img"><path fill="currentColor" d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.24c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.08 1.84 1.23 1.84 1.23 1.07 1.83 2.8 1.3 3.49.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.17 0 0 1-.32 3.3 1.23a11.46 11.46 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.87.12 3.17.77.84 1.23 1.91 1.23 3.22 0 4.62-2.81 5.65-5.49 5.95.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z" /></svg>
        <span class="sr-only">GitHub</span>
      </a>
    </footer>
  </body>
</html>
